l id="e40" value="imprime con" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mtorneos" target="vista"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e41" value="atiende a" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.43;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mentrenador" target="cempleado"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m42" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e41"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="m43" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e41"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e44" value="atiende a" style="endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="mfisio" target="cempleado"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m45" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e44"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="m46" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e44"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e47" value="registra partidos con" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.4;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="mentrenador" target="registro"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e48" value="registra practicas con" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="csocio" target="registro"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ley_t" value="&lt;b&gt;Paquetes&lt;/b&gt;" style="text;html=1;fontSize=11;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1620" y="60" width="200" height="20" as="geometry" /></mxCell><mxCell id="ley0" value="cds.consola" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1620" y="82" width="220" height="20" as="geometry" /></mxCell><mxCell id="ley1" value="otros paquetes (solo referencia)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1620" y="108" width="220" height="20" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Como funciona&lt;/b&gt;&lt;br&gt;1. main() crea la consola y llama iniciar().&lt;br&gt;2. iniciar() carga club.json, autentica y pide a la subclase su menu (construirMenu).&lt;br&gt;3. Cada opcion del Menu es una Accion (lambda this::metodo).&lt;br&gt;4. Menu.mostrar() atrapa ReglaNegocioException y muestra el mensaje: la consola solo pide y muestra, las reglas viven en Club y el modelo.&lt;br&gt;5. Al salir, iniciar() guarda club.json." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1620" y="150" width="360" height="180" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="d2" name="7. Clases detalladas - Persistencia"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1960" pageHeight="920" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="titulo" value="7. Clases detalladas - Paquete cds.persistencia" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry" /></mxCell><mxCell id="base" value="&lt;div style=&quot;text-align:center&quot;&gt;«abstract»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-style:italic&quot;&gt;ConsolaBase&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:9px&quot;&gt;(cds.consola)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;rounded=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="220" height="54" as="geometry" /></mxCell><mxCell id="club" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;Club&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:9px&quot;&gt;(cds)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;rounded=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="220" height="40" as="geometry" /></mxCell><mxCell id="archivo" value="&lt;div style=&quot;text-align:center&quot;&gt;«utility»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;ArchivoClub&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;- ARCHIVO: String = &quot;club.json&quot;  {readOnly}&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;+ guardar(club: Club, carpeta: String)  throws IOException&lt;br&gt;+ cargar(carpeta: String): Club  throws IOException&lt;br&gt;- guardarUsuarios / guardarEquipos / guardarInstalaciones(...)&lt;br&gt;- guardarAcademias / guardarCompetencias / guardarPartidos(...)&lt;br&gt;- guardarSesiones / guardarTienda / guardarTurnos / guardarSolicitudes(...)&lt;br&gt;- cargarClub(raiz: Map): Club&lt;br&gt;- cargarUsuarios / cargarEquipos / cargarInstalaciones(...)&lt;br&gt;- cargarAcademias / cargarCompetencias / cargarPartidos(...)&lt;br&gt;- cargarSesiones / cargarTienda / cargarTurnos / cargarSolicitudes(...)&lt;br&gt;- cargarEstadoUsuarios / cargarEstadoEquipos(...)&lt;br&gt;- usuario / socio / empleado / entrenador(club, login)  &lt;i&gt;// busca por login&lt;/i&gt;&lt;br&gt;- equipo / academia(club, nombre)  &lt;i&gt;// busca por nombre&lt;/i&gt;&lt;br&gt;- articulo / producto / ubicacion(tienda, nombre)&lt;br&gt;- indice&amp;lt;T&amp;gt;(lista, id: int, tipo: String): T&lt;br&gt;- texto / entero / decimal / booleano(objeto, campo)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;rounded=0;" vertex="1" parent="1"><mxGeometry x="420" y="70" width="470" height="280" as="geometry" /></mxCell><mxCell id="torneos" value="&lt;div style=&quot;text-align:center&quot;&gt;«utility»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;ArchivoTorneos&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;~ SECCION: String = &quot;torneos&quot;  {readOnly}&lt;br&gt;- RECREATIVO, COMPETITIVO: String  {readOnly}&lt;br&gt;- CONJUNTO, INDIVIDUAL: String  {readOnly}&lt;br&gt;- JUGADOR, PAREJA, EQUIPO: String  {readOnly}&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;- ArchivoTorneos()  &lt;i&gt;// no se instancia&lt;/i&gt;&lt;br&gt;~ guardar(club: Club): List&amp;lt;Object&amp;gt;&lt;br&gt;~ cargar(club: Club, raiz: Map)  throws IOException&lt;br&gt;~ guardarReferenciaBono(club: Club, bono: Bono): Map&lt;br&gt;~ cargarReferenciaBono(club: Club, ref: Map): Bono&lt;br&gt;- guardarTorneo / guardarEspecialidad / guardarParticipante(...)&lt;br&gt;- cargarTorneo / cargarEspecialidad / cargarParticipante(...)&lt;br&gt;- usuario(club, login): Usuario&lt;br&gt;- inscripcion(lista, id: int, torneo: String): InscripcionTorneo&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;rounded=0;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="470" height="238" as="geometry" /></mxCell><mxCell id="json" value="&lt;div style=&quot;text-align:center&quot;&gt;«utility»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;Json&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;(sin atributos)&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;+ leer(texto: String): Object&lt;br&gt;+ escribir(valor: Object, salida: PrintWriter)&lt;br&gt;+ objeto(): Map&amp;lt;String, Object&amp;gt;&lt;br&gt;+ arreglo(): List&amp;lt;Object&amp;gt;&lt;br&gt;+ comoObjeto(valor): Map  /  comoArreglo(valor): List&lt;br&gt;+ texto / textoOpcional(objeto, campo): String&lt;br&gt;+ entero / decimal / booleano(objeto, campo)&lt;br&gt;- escribirValor / escribirObjeto / escribirArreglo(...)&lt;br&gt;- escribirTexto(texto, salida)&lt;br&gt;- espacios(salida, nivel)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;rounded=0;" vertex="1" parent="1"><mxGeometry x="1060" y="70" width="400" height="210" as="geometry" /></mxCell><mxCell id="analizador" value="&lt;div style=&quot;text-align:center&quot;&gt;«clase interna privada»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;Json.Analizador&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;- texto: String  {readOnly}&lt;br&gt;- posicion: int&lt;/div&gt;&lt;hr size=&quot;1&quot; style=&quot;border:none;border-top:1px solid #82B366;margin:3px 0&quot;&gt;&lt;div style=&quot;margin-left:6px&quot;&gt;- leerValor(): Object&lt;br&gt;- leerObjeto(): Map&lt;br&gt;- leerArreglo(): List&lt;br&gt;- leerTexto(): String&lt;br&gt;- leerUnicode(): char&lt;br&gt;- leerNumero(): Number&lt;br&gt;- leerPalabra(palabra: String)&lt;br&gt;- espacios() / tomar(c) / exigir(c) / terminado()&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#000000;rounded=0;" vertex="1" parent="1"><mxGeometry x="1060" y="450" width="400" height="196" as="geometry" /></mxCell><mxCell id="torneo" value="&lt;div style=&quot;text-align:center&quot;&gt;«abstract»&lt;/div&gt;&lt;div style=&quot;text-align:center;font-weight:bold;font-style:italic&quot;&gt;Torneo&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:9px&quot;&gt;(cds.torneos)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;rounded=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="220" height="54" as="geometry" /></mxCell><mxCell id="bono" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;Bono&lt;/div&gt;&lt;div style=&quot;text-align:center;font-size:9px&quot;&gt;(cds.ventas)&lt;/div&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#F5F5F5;strokeColor=#666666;fontColor=#000000;rounded=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="220" height="40" as="geometry" /></mxCell><mxCell id="archivojson" value="&lt;b&gt;datos/club.json&lt;/b&gt;&lt;br&gt;un solo archivo con secciones:&lt;br&gt;usuarios, equipos, instalaciones, academias, competencias, partidos, sesiones, tienda, turnos, solicitudes, &lt;b&gt;torneos&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="30" y="200" width="240" height="120" as="geometry" /></mxCell><mxCell id="e1" value="carga al entrar y guarda al salir con" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.11;entryDx=0;entryDy=0;" edge="1" parent="1" source="base" target="archivo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="«create» reconstruye / recorre" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.95;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="archivo" target="club"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="delega la seccion torneos a" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="archivo" target="torneos"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="convierte con" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="archivo" target="json"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="convierte con" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="torneos" target="json"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="analiza el texto con" style="startArrow=diamondThin;startFill=1;startSize=14;endArrow=open;endFill=0;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="json" target="analizador"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m7" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="m8" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontStyle=1;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e6"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="e9" value="lee y escribe" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.48;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="archivo" target="archivojson"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="«create» reconstruye" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="torneos" target="torneo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="referencia (torneo + indice)" style="dashed=1;endArrow=open;endFill=0;endSize=10;html=1;rounded=0;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="torneos" target="bono"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ley_t" value="&lt;b&gt;Paquetes&lt;/b&gt;" style="text;html=1;fontSize=11;fontStyle=0;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1540" y="230" width="200" height="20" as="geometry" /></mxCell><mxCell id="ley0" value="cds.persistencia" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1540" y="252" width="220" height="20" as="geometry" /></mxCell><mxCell id="ley1" value="otros paquetes (solo referencia)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1540" y="278" width="220" height="20" as="geometry" /></mxCell><mxCell id="ley2" value="nota / archivo" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1540" y="304" width="220" height="20" as="geometry" /></mxCell><mxCell id="n_ref" value="&lt;b&gt;Referencias por nombre&lt;/b&gt;&lt;br&gt;En el JSON los objetos no se repiten: usuarios por &lt;b&gt;login&lt;/b&gt;; equipos, academias, articulos, productos y torneos por &lt;b&gt;nombre&lt;/b&gt;; instalaciones, partidos e inscripciones por &lt;b&gt;indice&lt;/b&gt;; un bono como &lt;b&gt;torneo + indice de inscripcion&lt;/b&gt;.&lt;br&gt;Es seguro porque login y nombres son unicos (Club lo valida) y no tienen setter. Si una referencia no existe, cargar() lanza IOException con un mensaje claro (prueba ArchivoClubTest.referenciaRota)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1540" y="340" width="380" height="160" as="geometry" /></mxCell><mxCell id="n_orden" value="&lt;b&gt;Orden de carga&lt;/b&gt;&lt;br&gt;usuarios → equipos → instalaciones → academias → competencias → partidos → sesiones → &lt;b&gt;torneos&lt;/b&gt; → tienda → turnos y solicitudes → estado de usuarios.&lt;br&gt;Los torneos van antes que la tienda porque una venta puede usar un bono ganado en un torneo.&lt;br&gt;El estado se restaura con metodos restaurar*() del modelo, sin volver a validar reglas (la historia ya ocurrio)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1540" y="530" width="380" height="150" as="geometry" /></mxCell><mxCell id="n_compat" value="&lt;b&gt;Compatibilidad&lt;/b&gt;&lt;br&gt;Un club.json del Proyecto 1 (sin seccion torneos) carga sin torneos." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1540" y="710" width="380" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>